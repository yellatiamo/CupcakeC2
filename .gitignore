# ==================================================
# Cupcake C2 - .gitignore
# ==================================================

# ---- Rust (Client) ----
/Client/target/
/Client/core/Client/   # Rust 编译中间产物
Cargo.lock             # 本项目作 binary，Cargo.lock 可以提交；如不需要则取消注释

# ---- Go (Server) ----
/server/dist/        # Go embed 打包用的前端产物
/server/ui/          # legacy frontend — obsolete; only dist is embedded
# keep ui/README.md if present (not ignored by directory pattern for tracked files)
/server/*.exe        # Windows 编译产物 (includes services.test.exe from go test -c)
/server/*.test.exe
/**/*.test.exe       # never commit go test -c outputs (AV magnet)
/server/services.test.exe
/server/cupcake-server  # Linux 编译产物
/server/cupcake-server-linux
/server/cupcake-server-linux-amd64
/server/temp_builds/
/server/services_crash.txt
/server/config.json  # local secrets — use config.example.json

# Agent templates / third-party plugins (build or download; do not commit binaries)
/server/assets/*.exe
/server/assets/plugins/*.exe
/server/storage/modules/*
!/server/storage/modules/.gitkeep
/server/storage/ad/
/storage/

# ---- Vue / Node.js (Frontend) ----
/server/frontend-v2/node_modules/
/server/frontend-v2/dist/
/server/frontend-v2/.vite/
/server/frontend-v2/auto-imports.d.ts
/server/frontend-v2/components.d.ts

# ---- 本地数据库（含账�?密码/Agent记录等敏感数据）----
/server/storage/*.db
/server/storage/*.db-shm
/server/storage/*.db-wal

# ---- Storage 运行时目录（含已编译 Payload，勿上传�?---
/server/storage/payloads/
/server/storage/agent_files/
/server/storage/logs/
/server/storage/build_cache/
/server/storage/public_tools/

# ---- IDE & 编辑�?----
.idea/
.vscode/
*.iml

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
*.log.*

# ---- 敏感文件 ----
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*

# ---- Claude Code ----
.claude/
.worktrees/

# ---- Local tooling / caches (do not publish) ----
.zcode/
**/__pycache__/
*.pyc
server/.go-build-cache/
server/.go-review-cache/
