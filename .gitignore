# ==================================================
# Cupcake C2 - .gitignore
# ==================================================

# ---- Rust (Client) ----
/Client/target/
/Client/core/Client/
# Cargo.lock is tracked for this binary workspace.

# ---- Go (Server) ----
# Generated frontend output and Go embed mirror.
/server/dist/
/server/web/dist/
/server/ui/

# Generated server binaries.
/server/*.exe
/server/*.test.exe
/**/*.test.exe
/server/services.test.exe
/server/cupcake-server
/server/cupcake-server-linux
/server/cupcake-server-linux-amd64
/server/temp_builds/
/server/services_crash.txt

# Local server configuration and secrets.
/server/config.json

# Agent templates and third-party plugin binaries.
/server/assets/*.exe
/server/assets/*.dll
/server/assets/*.bin
/server/assets/plugins/*.exe
/server/assets/plugins/*.dll
/server/assets/plugins/*.o
/server/assets/plugins/*.obj

# Runtime modules and generated storage.
/server/storage/*
!/server/storage/modules/
/server/storage/modules/*
!/server/storage/modules/.gitkeep
/storage/

# ---- Vue / Node.js (Frontend) ----
/server/frontend-v2/node_modules/
/server/frontend-v2/dist/
/server/frontend-v2/.vite/
/server/frontend-v2/auto-imports.d.ts
/server/frontend-v2/components.d.ts

# ---- Local databases ----
/server/storage/*.db
/server/storage/*.db-shm
/server/storage/*.db-wal

# ---- Runtime directories ----
/server/storage/payloads/
/server/storage/agent_files/
/server/storage/logs/
/server/storage/build_cache/
/server/storage/public_tools/
/server/storage/ad/

# ---- IDE and editor ----
.idea/
.vscode/
*.iml

# ---- Operating system ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
*.log.*

# ---- Sensitive files ----
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*

# ---- Local tooling ----
.claude/
.worktrees/
.zcode/
/.go-cache/
server/.go-build-cache/
server/.go-review-cache/
**/__pycache__/
*.pyc
